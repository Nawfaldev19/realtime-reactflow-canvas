# Copy the lines you need into server/.env or client/.env, or export them.
# Every value has a working default for local development.

# --- server (Rails) ---
PORT=3000
# Comma-separated web app origins allowed to call the API and open the socket.
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=info
DATABASE_PATH=storage/development.sqlite3
RAILS_MAX_THREADS=5
# Demo sign-ins allowed per client address per minute.
SIGN_IN_LIMIT_PER_MINUTE=20
# Required only when RAILS_ENV=production. Generate with: bin/rails secret
SECRET_KEY_BASE=replace-me
# Production only: redirect to HTTPS and send HSTS.
FORCE_SSL=false

# --- client (Vite) ---
VITE_API_URL=http://localhost:3000/graphql
# The collaboration socket (ActionCable); defaults to /cable next to VITE_API_URL.
VITE_CABLE_URL=ws://localhost:3000/cable
# Playwright browsers are kept inside the project.
PLAYWRIGHT_BROWSERS_PATH=.pw-browsers
# Benchmark (npm run bench) narrowing; all sizes, configurations and 3 repeats by default.
# BENCH_SIZES=1000
# BENCH_CONFIGS=all on,no-visible
# BENCH_REPEATS=1
