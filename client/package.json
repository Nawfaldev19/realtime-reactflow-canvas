{
  "name": "live-canvas-client",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "bench": "playwright test --config playwright.bench.config.ts",
    "codegen": "graphql-codegen --config codegen.ts",
    "screenshot": "playwright test --config playwright.screenshot.config.ts screenshot.ts",
    "record:hero": "playwright test --config playwright.screenshot.config.ts record-hero.ts"
  },
  "dependencies": {
    "@apollo/client": "^3.13.0",
    "@dagrejs/dagre": "^3.1.1",
    "@rails/actioncable": "^8.0.500",
    "@xyflow/react": "^12.8.0",
    "graphql": "^16.9.0",
    "html-to-image": "1.11.11",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@graphql-codegen/cli": "^5.0.3",
    "@graphql-codegen/client-preset": "^4.5.0",
    "@playwright/test": "1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.19.43",
    "@types/pngjs": "6.0.5",
    "@types/rails__actioncable": "^8.0.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.5",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "gifenc": "1.0.3",
    "globals": "^15.12.0",
    "jsdom": "^25.0.1",
    "pngjs": "7.0.0",
    "prettier": "3.3.3",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  },
  "overrides": {
    "lodash": "^4.18.1"
  }
}
